# Copiá este archivo a .env y completá. NUNCA subas .env a git.

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets (opcional) ---
SPREADSHEET_ID=
# Una de las dos: el JSON completo de la service account, o la ruta al archivo
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=credenciales.json

# --- IA: se prueban en este orden; los que no tengan key se saltean ---
IA_PROVEEDORES=gemini,groq,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Los nombres de modelo cambian seguido; si uno deja de existir, pisalo acá:
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=

# --- Modelo ---
# last: último operado (lo único que trae el feed de BYMA Educa). bid_ask: solo si el feed trajera puntas.
MODO_PRECIO=last
# Modo last: penalización en contra para aproximar el spread (0.02 = 2%)
SLIPPAGE_PCT=0.02
# Modo last: operaciones mínimas en la rueda para aceptar el precio de una opción
OPS_MIN=1
# Modo last: diferencia horaria máxima (minutos) entre las patas de una estructura
SINCRONIA_MAX_MIN=30
# Modo last: antigüedad máxima (minutos) respecto del último operado del subyacente; 0 = apagado
EDAD_MAX_MIN=0
# Solo se usa si el feed no trae la tasa libre de un vencimiento
TASA_LIBRE_DEFAULT_PCT=35
# Probabilidad mínima (0 a 1) de superar la tasa libre
PROB_EXITO_MIN=0.25
